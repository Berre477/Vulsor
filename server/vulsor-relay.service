[Unit]
Description=Vulsor relay server (public password-protected servers)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Edit User and paths to match your machine:
User=USER
WorkingDirectory=/home/USER/vulsor-server
ExecStart=/usr/bin/node /home/USER/vulsor-server/relay-server.js
Environment=RELAY_PORT=8480
Environment=RELAY_DIR=/home/USER/vulsor-server/relay-data
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
